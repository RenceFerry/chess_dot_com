generator client {
  provider = "prisma-client"
  output   = "../app/_lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Outcome {
  W
  L
  D
}

enum Mode {
  Classic
  Rapid
  Bullet
  Blitz
}

model users {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  name       String   @unique 
  email      String   @unique
  password   String?
  image      String?
  elo        Int      @default(200)

  followers  follower[] @relation("followers")
  following  follower[] @relation("following")
  gamePlayer gamePlayer[]
  chats      chat[]
  settings   settings?
}

model settings {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid @unique
  streamGame Boolean  @default(false)
  chatDisable Boolean @default(false)
  chatPrivate Boolean @default(false)

  user       users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model shortInfo {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String   @unique
  info       String
  ex         DateTime @db.Timestamptz(6)
}

model game {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date       DateTime @db.Timestamptz(6)
  fen        String
  moves      String
  mode       Mode

  players    gamePlayer[]
  chats      chat[]
}

model gamePlayer {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  outcome    Outcome
  gameId     String   @db.Uuid

  game       game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player     users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model chat {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  userId     String   @db.Uuid
  gameId     String   @db.Uuid
  message    String

  user       users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  game       game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model follower {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId   String   @db.Uuid
  followerId String   @db.Uuid

  player     users    @relation("followers", fields: [playerId], references: [id], onDelete: Cascade)
  follower   users    @relation("following", fields: [followerId], references: [id], onDelete: Cascade)

  @@unique([playerId, followerId])
}